---
import { getPhotoInfo } from '../../lib/photo-store.mjs';

export const prerender = false;
const photo = await getPhotoInfo(Astro.params.id);
if (!photo) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const imageUrl = `/api/fotos/${Astro.params.id}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tu foto | Astellas</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      body {
        margin: 0;
        padding: 24px;
        min-height: 100vh;
        box-sizing: border-box;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 20px;
        background: #241827;
        color: white;
        font:
          16px/1.4 Arial,
          sans-serif;
        text-align: center;
      }
      img {
        display: block;
        width: min(100%, 420px);
        max-height: 75vh;
        object-fit: contain;
      }
      a {
        display: inline-block;
        padding: 14px 24px;
        background: #ffb755;
        color: #431d15;
        font-weight: bold;
        text-decoration: none;
        border-radius: 6px;
      }
      p {
        max-width: 420px;
        margin: 0;
      }
    </style>
  </head>
  <body>
    {photo ? (
      <>
        <h1>Tu foto está lista</h1>
        <img src={imageUrl} alt="Tu fotografía con mapa de calor" />
        <a href={imageUrl} download="Astellas-TomaElControl.webp">
          DESCARGAR FOTO
        </a>
        <p>
          Disponible hasta el{' '}
          {new Intl.DateTimeFormat('es-CO', {
            dateStyle: 'long',
            timeStyle: 'short',
            timeZone: 'America/Bogota',
          }).format(photo.expiresAt)}
          .
        </p>
      </>
    ) : (
      <>
        <h1>Esta foto ya no está disponible</h1>
        <p>Las fotos se eliminan automáticamente después de 2 días.</p>
      </>
    )}
  </body>
</html>
