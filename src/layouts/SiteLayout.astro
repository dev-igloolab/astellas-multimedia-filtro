---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/design.css';
interface Props {
  title?: string;
}
const { title = 'Astellas · Toma el control de tu menopausia' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ed174b" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
